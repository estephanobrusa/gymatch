{
  "name": "@gymatch/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma DB client singleton for Gymatch workspaces",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "DATABASE_URL=$(grep '^DIRECT_URL' ../../apps/web/.env.local | cut -d'\"' -f2) tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
