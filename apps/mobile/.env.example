# ─────────────────────────────────────────────────────────
# GYMATCH MOBILE — Environment variables (Expo)
#
# Copy this file to `.env.local` and fill in real values.
# All variables must use the `EXPO_PUBLIC_` prefix to be
# inlined into the JS bundle by Metro (statically replaced
# at bundle time — do NOT put secrets here).
# ─────────────────────────────────────────────────────────

# Supabase project (same values as apps/web/.env.local, prefixed EXPO_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# API base URL for the REST backend (apps/web, /api/v1/*).
# - Dev (iOS simulator): http://localhost:3000
# - Dev (physical device): http://<LAN-IP>:3000 (the app auto-derives this
#   from the Metro packager host when this var is unset)
# - Production: https://<your-server-domain>
EXPO_PUBLIC_API_URL=