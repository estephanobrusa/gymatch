# ─────────────────────────────────────────────────────────────
# DATABASE — Supabase / Local Docker
# ─────────────────────────────────────────────────────────────

# Supabase pooler URL (port 6543) — used by Prisma at runtime for queries.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://gymatch:gymatch@localhost:6543/gymatch?pgbouncer=true&connection_limit=1"

# Direct connection URL (port 5432) — used by Prisma for migrations (bypasses pooler).
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# For local Docker: use localhost:5432 with credentials from docker-compose.yml
DIRECT_URL="postgresql://gymatch:gymatch@localhost:5432/gymatch"

# ─────────────────────────────────────────────────────────────
# SUPABASE — Public client config (safe to expose in browser)
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL — found in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Your Supabase anonymous (public) key — safe for browser usage, scoped by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# ─────────────────────────────────────────────────────────────
# SUPABASE — Server-only secrets (NEVER expose to the browser)
# ─────────────────────────────────────────────────────────────

# Service role key — bypasses RLS; use only in server-side code (Route Handlers, Server Actions).
# Found in Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ─────────────────────────────────────────────────────────────
# AUTH — Admin database connection (service role, bypasses RLS)
# ─────────────────────────────────────────────────────────────

# Direct connection (port 5432) using the service role key as the password.
# Used by prismaAdmin in lib/auth/admin.ts for all server-side mutations.
# Format: postgresql://postgres:[SERVICE_ROLE_KEY]@db.[ref].supabase.co:5432/postgres
# For local Docker: postgresql://gymatch:gymatch@localhost:5432/gymatch
ADMIN_DATABASE_URL="postgresql://postgres:[service-role-key]@db.your-project-ref.supabase.co:5432/postgres"

# ─────────────────────────────────────────────────────────────
# GOOGLE PLACES API — Server-only (NEVER expose to browser)
# ─────────────────────────────────────────────────────────────

# API key for Google Places API (New) — used server-side in searchGyms action.
# Do NOT prefix with NEXT_PUBLIC_ — this key must never reach the client bundle.
# Obtain from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_PLACES_API_KEY="your-google-places-api-key-here"

# ─────────────────────────────────────────────────────────────
# FEATURE FLAGS — Swipe system (NEXT_PUBLIC = readable in browser + server)
# ─────────────────────────────────────────────────────────────

# Super Like gesture — disabled for MVP; set to "true" to enable
NEXT_PUBLIC_FEATURE_SUPER_LIKE="false"

# Rewind (undo last swipe) — disabled for MVP; set to "true" to enable
NEXT_PUBLIC_FEATURE_REWIND="false"

# Unlimited Likes — disabled for MVP; set to "true" to enable
NEXT_PUBLIC_FEATURE_UNLIMITED_LIKES="false"
